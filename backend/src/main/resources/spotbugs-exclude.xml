<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- A Spring DI-hoz kapcsolódó téves riasztások figyelmen kívül hagyása -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- 
        Entity kapcsolatoknál jön elő: 
        "A User osztályban van egy olyan mező (transactions), ami nem serializable, és ez baj lehet, ha a User-t valaha serializálni akarod."
        Nem lehet serializálni az entitásokat 
    -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <!-- domain objecteknél jön elő, amikor constructorba hibát dobunk  -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>