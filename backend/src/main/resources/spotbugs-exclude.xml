<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore false positives related to Spring DI -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- 
        Entity kapcsolatoknál jön elő: 
        "A User osztályban van egy olyan mező (transactions), ami nem serializable, és ez baj lehet, ha a User-t valaha serializálni akarod."
        Nem lehet serializálni az entitásokat 
    -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
</FindBugsFilter>